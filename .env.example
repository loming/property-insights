# Copy to .env (git-ignored); Docker Compose reads it automatically.

# Host port of the nginx gateway, the only published port. It is bound to 127.0.0.1.
GATEWAY_PORT=8130

# Uncomment to start the Ridge set alongside the brief set
# (the same as passing --profile ridge to every docker compose command).
# COMPOSE_PROFILES=ridge

# Where each set's "switch" link points. The defaults suit a local run through the gateway.
# BRIEF_PUBLIC_URL=http://localhost:8130
# RIDGE_PUBLIC_URL=http://ridge.localhost:8130
